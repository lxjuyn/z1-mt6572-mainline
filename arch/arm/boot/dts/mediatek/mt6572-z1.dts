// SPDX-License-Identifier: GPL-2.0
/*
 * Z1 / V100 hearing-aid device (佳伯听力机 Z1)
 * Based on mt6572-jty-d101.dts by Max Shevchenko.
 * Minimal bring-up Z1 dts: eMMC (mmc0) + UART + USB only.
 * Screen (ST7785M 240x320 DSI) intentionally disabled for first boot.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "mt6572.dtsi"
#include "mt6323.dtsi"

/ {
	model = "Z1 hearing-aid";
	compatible = "jbo,z1", "mediatek,mt6572";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		/*
		 * Z1 diagnostic: do not instantiate an early console from DT.
		 * v13.4 correction (review W1, 2026-08-29): this LK does NOT
		 * forward the boot.img header --cmdline (board logs 8/26-27 show
		 * the kernel cmdline equals these DT bootargs verbatim), so the
		 * console selection lives HERE. The mainline 8250 registers the
		 * uart0 OF node as ttyS0 (alias serial0), not ttyMT0; the last
		 * console= wins /dev/console, so ttyS0 last gives the serial
		 * port both the kernel log tail and the final console getty.
		 */
		bootargs = "console=ttyS0,921600n8 root=/dev/ram panic=10 loglevel=7 clk_ignore_unused regulator_ignore_unused oops=panic sysrq_always_enabled rdinit=/init earlycon=mtk8250,0x11005000 androidboot.hardware=z1 androidboot.selinux=permissive firmware_class.path=/system/etc/firmware printk.devkmsg=on";
		/*
		 * Z1 LK relocates the MTK ROOTFS payload to 0x84100000.  Its
		 * ATAG_INITRD2 handoff is not present at runtime, so provide the
		 * measured range explicitly for this packaged logger ramdisk.
		 * RULE: linux,initrd-end MUST equal 0x84100000 + ramdisk payload
		 * byte count; it must be recomputed whenever the ramdisk is
		 * replaced or re-compressed, or the initrd gets truncated and
		 * the gzip stream aborts with "read error".
		 * Current payload: out/ramdisk_v13_5_acm.gz body is
		 * 1,269,042 (0x135d32) bytes (file is 1,269,554 B incl. the
		 * 512B MTK ROOTFS header), so end = 0x84100000 + 0x135d32.
		 * v13.3 ramdisk: /init rewritten to bind a mainline configfs
		 * CDC-ACM gadget -> /dev/ttyGS0 (replaces dead android_usb path).
		 * v13.3b: review fixes - full [acm] self-reporting (incl. ln -s
		 * result) and [ -e /dev/tty0 ] guard on the tty0 getty.
		 * v13.4: same /init as v13.3b + sbin/i2cprobe (narrow-address
		 * probe + read-only register dump) for the CST836U@0x15 /
		 * S6-FTS@0x38 touch identity evidence run.
		 * v13.4r (review fixes 2026-08-29): /init PID1 console getty now
		 * respawns in a loop (shell exit no longer kills PID1 -> panic
		 * reboot); i2cprobe binds I2C_SLAVE before SMBus quick (was
		 * probing stale client addr) and reports EBUSY distinctly;
		 * stray packaging artifact body_new.gz dropped from archive.
		 * v13.5 (2026-08-29): = v13.4r + klog-over-ACM forwarding — /init
		 * backgrounded setsid mirror: dmesg full ring dump then live
		 * tail -f /proc/kmsg to /dev/ttyGS0 ([klog] banners), kernel-log
		 * channel for S6 which has no UART testpoints.
		 */
		linux,initrd-start = <0x84100000>;
		linux,initrd-end = <0x842e1abf>;

		/* LK leaves OVL layer 2 scanning this 240x320 RGB565 surface. */
		framebuffer0: framebuffer@bfd00000 {
			compatible = "simple-framebuffer";
			reg = <0xbfd00000 0x28000>;
			width = <240>;
			height = <320>;
			stride = <512>;
			format = "r5g6b5";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * CONN (WiFi/BT) carveout relocated from the original 0x80000000
		 * (right at RAM base) up to 0xbe000000 so it no longer shadows the
		 * low-RAM region the Z1 LK/preloader uses during early boot.
		 * Kept as 1 MiB no-map to match the old size.  The mt6572-connsys
		 * driver zeroes the "shared EMI" area it gets from connsys_pwr
		 * reg[1] (see below).
		 *
		 * NOTE: this EMI base relocation is a bring-up workaround -- the
		 * vendor CONN firmware may be built against a fixed shared-EMI
		 * base of 0x80080000.  If the CONN MCU misbehaves after this
		 * change, revert both this carveout AND connsys_pwr reg[1]
		 * together.
		 */
		connsys@be000000 {
			reg = <0xbe000000 0x100000>;
			no-map;
		};

		framebuffer_reserved: framebuffer@bf400000 {
			reg = <0xbf400000 0xc00000>;
			no-map;
		};

		default-pool {
			compatible = "shared-dma-pool";
			size = <0x6000000>;
			alloc-ranges = <0x90000000 0x10000000>;
			reusable;
			linux,cma-default;
		};
	};

	/*
	 * CONN (WiFi/BT) subsystem consumer. This node binds the in-tree
	 * driver drivers/soc/mediatek/mtk6572-connsys.c (compatible
	 * "mediatek,mt6572-connsys"): it powers VCN18/VCN28, powers on the
	 * MT6572 CONN SCPSYS domain (registered default-off in mt6572.dtsi),
	 * polls the CONN MCU chip ID at 0x18070000+0x8 and zeroes the shared
	 * EMI at 0xbe080000. Keep status="disabled" until the board bring-up
	 * sequence is gated-tested; also keep the 1 MiB reserved-memory
	 * carveout at 0xbe000000 (above) mapped when enabling.
	 *
	 * reg[1] is the shared EMI, relocated to 0xbe080000 to match the
	 * reserved-memory carveout above.  This is a temporary relocation:
	 * the vendor CONN firmware may be fixed at 0x80080000 -- if the CONN
	 * MCU does not come up, revert both reg[1] and the carveout together.
	 */
	connsys_pwr: connsys@18070000 {
		compatible = "mediatek,mt6572-connsys";
		reg = <0x18070000 0x1000>,
		      <0xbe080000 0x55c00>;	/* CONN MCU config + shared EMI */
		power-domains = <&spm MT6572_POWER_DOMAIN_CONN>;
		vcn18-supply = <&mt6323_vcn18_reg>;
		vcn28-supply = <&mt6323_vcn28_reg>;
		vcn33_bt-supply = <&mt6323_vcn33_bt_reg>;
		vcn33_wifi-supply = <&mt6323_vcn33_wifi_reg>;
		status = "disabled";
	};

	/*
	 * CONNSYS out-of-tree stack DT nodes (mt6572-connsys-modules, forward
	 * port of the vendor conn_soc family).  These bind the external .ko
	 * platform drivers:
	 *   btif@1100e000      -> mtk_btif_drv.ko  ("mediatek,btif")
	 *   connectivity@18070000 -> mtk_stp_wmt_soc.ko / mtk_wmt_wifi_soc.ko
	 *                        ("mediatek,mt6572-consys")
	 *   wifi@180f0000      -> wlan_gen2.ko     ("mediatek,wifi")
	 *
	 * IRQ numbers are the vendor MT6572 GIC SPI IDs (mt_irq.h,
	 * GIC_PRIVATE_SIGNALS + N): BTIF=52, APDMA-BTIF-TX=41, APDMA-BTIF-RX=42,
	 * CONN2AP/BTIF-wakeup=122, WF_HIF=123, CONN_WDT=124.
	 *
	 * The old in-tree connsys_pwr node above stays disabled: it binds
	 * drivers/soc/mediatek/mtk6572-connsys.c and must not double-power the
	 * CONN domain / regulators with this stack.
	 */
	btif: btif@1100e000 {
		compatible = "mediatek,btif";
		#address-cells = <1>;
		#size-cells = <1>;
		/*
		 * ranges needed: btif_rx/btif_tx child nodes are of_iomap'd by
		 * the vendor driver (hal_dma_set_default_setting). Without
		 * ranges, of_translate_one fails (drivers/of/address.c) and
		 * of_iomap returns NULL -> hal_btif_dma_hw_init Oopses on
		 * NULL base during CONNSYS func-on. Empty ranges = 1:1.
		 */
		ranges;
		reg = <0x1100e000 0x1000>,
		      <0x11000380 0x80>,
		      <0x11000400 0x80>;
		interrupts = <GIC_SPI 52 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&topckgen CLK_TOP_BTIF>,
			 <&topckgen CLK_TOP_APDMA>;
		clock-names = "btifc", "apdmac";

		btif_tx: btif_tx@11000380 {
			compatible = "mediatek,btif_tx";
			reg = <0x11000380 0x80>;
			interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_LOW>;
		};

		btif_rx: btif_rx@11000400 {
			compatible = "mediatek,btif_rx";
			reg = <0x11000400 0x80>;
			interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_LOW>;
		};
	};

	connectivity: connectivity@18070000 {
		compatible = "mediatek,mt6572-consys";
		/*
		 * reg[0] = CONN MCU config (chip ID poll @ +0x8, expects 0x6572).
		 * reg[1] = TOPCKGEN block base: the driver does of_iomap(node,1)
		 * and pokes AP2CONN_OSC_EN at base+0x1800 (phys 0x10001800),
		 * so the range must cover 0x10001800.
		 */
		reg = <0x18070000 0x1000>,
		      <0x10000000 0x2000>;
		interrupts = <GIC_SPI 122 IRQ_TYPE_LEVEL_LOW>,	/* CONN2AP / BTIF wakeup */
			     <GIC_SPI 124 IRQ_TYPE_LEVEL_LOW>;	/* CONN WDT */
		mediatek,pwrap-regmap = <&pwrap>;
		power-domains = <&spm MT6572_POWER_DOMAIN_CONN>;
		resets = <&watchdog MT6572_TOPRGU_CONNSYS_SW_RST>;
		reset-names = "connsys";
		vcn18-supply = <&mt6323_vcn18_reg>;
		vcn28-supply = <&mt6323_vcn28_reg>;
		vcn33_bt-supply = <&mt6323_vcn33_bt_reg>;
		vcn33_wifi-supply = <&mt6323_vcn33_wifi_reg>;
	};

	wifi: wifi@180f0000 {
		compatible = "mediatek,wifi";
		reg = <0x180f0000 0x1000>;
		interrupts = <GIC_SPI 123 IRQ_TYPE_LEVEL_LOW>;
	};

	/*
	 * Audio front-end (AFE). Physical base 0x11140000 is the MT6572
	 * audsys block. This node binds the in-tree ASoC driver
	 * sound/soc/mediatek/mt6572/mt6572-afe-pcm.c (compatible
	 * "mediatek,mt6572-audio"): it maps the AFE registers, requests the
	 * "audio"/"audio_intbus_sel" topckgen clocks and wires the ASYS IRQ.
	 * Keep disabled until CONFIG_SND_SOC_MT6572 + the MT6323 codec path
	 * are ready; the IRQ below is an unverified placeholder (the driver
	 * notes the real ASYS/AFE IRQ number is not confirmed yet). The Z1
	 * machine card would be a separate "mediatek,mt6572-sound" node
	 * (mt6572-machine.c) referencing this node via "mediatek,platform".
	 */
	audsys: audio@11140000 {
		compatible = "mediatek,mt6572-audio";
		reg = <0x11140000 0x600>;
		clocks = <&topckgen CLK_TOP_AUDIO>,
			 <&topckgen CLK_TOP_AUDIO_INTBUS_SEL>;
		clock-names = "audio", "audio_intbus_sel";
		interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_LOW>; /* vendor AudDrv IRQ (MT_AFE_IRQ_MCU_ID=GIC_SPI 64) */
		status = "okay";
	};

	/*
	 * Machine sound card (mt6572-machine.c, compatible
	 * "mediatek,mt6572-sound").  Binds the AFE platform (&audsys) to the
	 * MT6323 PMIC codec (&codec, a child of &pmic via mt6323.dtsi).
	 *
	 * ENABLE CONDITIONS (all three required):
	 *   - CONFIG_SND_SOC_MT6572=y/m and the mt6323 codec module built
	 *   - &audsys above set to status="okay" (AFE clocks/IRQ wired)
	 *   - pwrap write-deny lifted so the MT6323 codec register path works
	 * Once those hold, set status="okay" here (and on &audsys) to probe
	 * the card.  Until then this node is kept disabled so the DTS parses
	 * cleanly but no card is instantiated.
	 */
	sound: sound {
		compatible = "mediatek,mt6572-mt6323-sound";
		audio-routing = "Speaker", "Speaker", "Earpiece", "Earpiece";
		mediatek,platform = <&audsys>;
		mediatek,audio-codec = <&codec>;
		status = "okay";
	};

	/*
	 * Battery monitoring: static pack characteristics + ADC-backed meter.
	 *
	 * battery (simple-battery) holds only the static Z1 pack data.  The
	 * values below are a generic Li-ion 3.7 V / ~2000 mAh placeholder --
	 * TBC against the real Z1 battery on first physical measurement.
	 *
	 * adc_battery (adc-battery) reads two MT6323 AUXADC channels via
	 * &mt6323_adc (mediatek,mt6323-auxadc, a child of &pmic):
	 *   - BATSNS (channel 7)  -> "voltage"     (battery terminal voltage)
	 *   - BAT_TEMP (channel 2) -> "temperature" (battery temperature)
	 *
	 * Keep status="disabled" until the kernel is built with:
	 *   CONFIG_POWER_SUPPLY=y          (currently not set)
	 *   CONFIG_GENERIC_ADC_BATTERY=y   (adc-battery driver, not set)
	 *   CONFIG_MEDIATEK_MT6323_AUXADC=y (IIO auxadc channels, not set)
	 * Only CONFIG_IIO=y is enabled in the current Z1 .config; without
	 * MEDIATEK_MT6323_AUXADC there are no IIO channels for adc-battery
	 * to consume, so leave this disabled until those three are on.
	 */
	/*
	 * battery_data (simple-battery): static pack characteristics.
	 * Named "battery_data" so the ADC-backed meter can own the node
	 * name "battery" — Android's health HAL looks up
	 * /sys/class/power_supply/battery/, and generic-adc-battery names
	 * its supply after the DT node (psy_desc->name = dev_name).
	 */
	battery_data: battery_data {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <2000000>; /* TBC: Z1 pack */
		voltage-max-design-microvolt = <4200000>;
		voltage-min-design-microvolt = <3300000>;
		status = "okay";
	};

	/* The meter owns the "battery" name for the Android health HAL. */
	adc_battery: battery {
		compatible = "adc-battery";
		io-channels = <&mt6323_adc MT6323_AUXADC_BATSNS>,
			      <&mt6323_adc MT6323_AUXADC_BAT_TEMP>;
		io-channel-names = "voltage", "temperature";
		monitored-battery = <&battery_data>;
		/*
		 * Generic Li-ion open-circuit discharge curve (uV, %),
		 * voltage descending. TBC against the real Z1 pack; adjust
		 * after first on-device voltage/percentage comparison.
		 */
		voltage-capacity-table = <
			4200000 100
			4150000 95
			4100000 89
			4050000 83
			4000000 77
			3950000 70
			3900000 62
			3850000 53
			3800000 43
			3750000 33
			3700000 23
			3650000 13
			3600000 6
			3450000 2
			3300000 0
		>;
		status = "okay";
	};

	/*
	 * Z1 USB VBUS supply (fixed regulator).
	 * Z1 operates exclusively as a USB device (CDC-ACM gadget). The USB PHY
	 * requires a VBUS supply to detect host connection and enter device mode.
	 * Without this, the PHY probe succeeds but UDC registration fails silently
	 * because the VBUS comparator never signals "device ready" to the MUSB core.
	 *
	 * This is a fixed regulator marked always-on because Z1 has no physical
	 * VBUS switch — the USB connector is wired directly to the PHY, and VBUS
	 * is always present when connected to a host.
	 */
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
};

&uart0 {
	status = "okay";
};

&usb {
	status = "okay";
	dr_mode = "peripheral";  /* Z1 only acts as USB device (CDC-ACM gadget); never host */
	/*
	 * USB peripheral mode requires proper PHY initialization.
	 * The mt6572-usb2-phy driver performs HS slew-rate calibration
	 * which may timeout but continues with default values.
	 *
	 * VBUS supply: Z1 has no physical VBUS regulator; VBUS is provided
	 * by the USB host (PC). The PHY driver forces VBUS comparator on
	 * via software (reg 0x1a bit4). Adding explicit vbus-supply ensures
	 * the MUSB glue doesn't defer probe waiting for a regulator.
	 * If regulator framework can't find this supply, it auto-provides
	 * a dummy regulator that always returns success.
	 */
	phys = <&u2phy0>;
	phy-names = "usb2";
	vbus-supply = <&mt6323_vusb_reg>;
};

&u2phy0 {
	status = "okay";
	/*
	 * PHY probe happens early (0.097s in logs). The driver handles
	 * HS slew-rate calibration timeout gracefully with fallback values.
	 * No additional properties needed - reg and #phy-cells from base dtsi.
	 */
};

/*
 * PMIC subsystem bring-up (post eMMC): the MT6323 MFD exposes the power
 * key, RTC and regulators.  LK already left VEMC/VIO18 powered, so the
 * regulators probe read-only (the Z1 pwrap write-deny gate still blocks
 * MT6323 writes).  PMIC_EINT is GPIO7.
 */
&pmic {
	pinctrl-0 = <&pmic_int_pins>;
	pinctrl-names = "default";
	interrupts-extended = <&pio 7 IRQ_TYPE_LEVEL_HIGH>;
	status = "okay";
};

&mt6323regulator {
	status = "okay";
};

/*
 * eMMC VCC: LK leaves VEMC on, but the mmc0 node has no vmmc-supply and
 * the Z1 fork skips mmc_regulator_get_supply, so VEMC ends up with zero
 * consumers and regulator late-cleanup powers it off ~39.5s into boot.
 * That drops the eMMC rail and turns every subsequent block read into a
 * -110 R1B CMD6 busy abort.  Mark it always-on to keep the rail up.
 */
&mt6323_vemc3v3_reg {
	regulator-always-on;
};

/*
 * vmc/vmch (eMMC card power) + vusb (USB PHY): same zero-consumer trap as
 * VEMC.  mt6323.dtsi marks them regulator-boot-on (LK leaves them on) but
 * without always-on, regulator late-cleanup powers them off ~39.5s into boot
 * and the board resets (Jump to BL / preloader reboot loop).  Keep all three
 * on to stop the ~39s reboot cycle.  Z1 mmc0 has no vmmc-supply (fork skips
 * mmc_regulator_get_supply) so they have zero consumers and must be held up.
 */
&mt6323_vmc_reg {
	regulator-always-on;
};

&mt6323_vmch_reg {
	regulator-always-on;
};

&mt6323_vusb_reg {
	regulator-always-on;
};

/*
 * VGP1 = touch panel AVDD28 (2.8V) on Z1, and the exact same
 * zero-consumer trap as VEMC/VMC/VMCH/VUSB above -- but the one instance
 * that was left unfixed, and the reason every historical touch run failed.
 *
 * Evidence chain (2026-10-28, byte-level, see HANDOFF_20261028.md §4.1):
 *  - The only consumer in the whole tree is the (disabled) touchscreen@5d
 *    node: AVDD28-supply = <&mt6323_vgp1_reg>. The custom polled driver
 *    z1_cst836u.ko creates its own i2c client at runtime and therefore has
 *    NO devm_regulator_get() calls at all (grep: 0 hits) -- it never touches
 *    VGP1, it just assumes the rail is up.
 *  - z1_gpio_hunt.ko, the fallback hunter, says so in its own comments
 *    ("dts 已给 VGP1 加 always-on（上电根因已修）") -- but that edit was
 *    never actually made. Both drivers assume someone else powered it.
 *  - So VGP1 has zero consumers, mt6323.dtsi does NOT mark it boot-on
 *    (unlike vmc/vmch/vusb), and regulator late-cleanup leaves it off.
 *    Touch then NACKs at 0x15 forever: ENXIO = unpowered.
 *
 * This makes regulator_register() call _regulator_do_enable() directly at
 * probe time (drivers/regulator/core.c:1647-1685), so AVDD28 is up long
 * before z1_touch_load.sh runs in "on post-fs".
 *
 * Do NOT remove without replacing it with an explicit enable somewhere:
 * the driver does not enable it itself, so dropping this silently returns
 * the board to "touch chip absent or unpowered".
 */
&mt6323_vgp1_reg {
	regulator-always-on;
};

/*
 * PMIC power/home keys.  The MT6323 "home" key maps to KEY_VOLUMEDOWN (114)
 * which duplicates the matrix keypad MATRIX_KEY(1, 0, KEY_VOLUMEDOWN) (see
 * &keyboard).  Disable the PMIC home key so volume-down is reported once;
 * the PMIC power key (KEY_POWER, 116) stays enabled.
 */
&mt6323keys {
	power-off-time-sec = <5>;
	home {
		status = "disabled";
	};
};

&pwrap {
	assigned-clocks = <&topckgen CLK_TOP_PMIC_SPI_SEL>;
	assigned-clock-parents = <&uart_clk>;
};

&mmc0 {
	compatible = "mediatek,mt6572-mmc",
		     "mediatek,mt7623-mmc",
		     "mediatek,mt2701-mmc";
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-names = "z1-validated";
	bus-width = <1>;
	max-frequency = <50000000>;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&pio {
	pmic_int_pins: pmic-int-pins {
		pins {
			pinmux = <MT6572_PIN_7_PMIC_EINT__FUNC_PMIC_EINT>;
			input-enable;
			bias-pull-down;
		};
	};

	pwrap_pins: pwrap-pins {
		pins {
			pinmux = <MT6572_PIN_8_PMIC_SPI_CSN__FUNC_PMIC_SPI_CSN>,
				 <MT6572_PIN_9_PMIC_SPI_SCK__FUNC_PMIC_SPI_SCK>,
				 <MT6572_PIN_10_PMIC_SPI_MOSI__FUNC_PMIC_SPI_MOSI>,
				 <MT6572_PIN_11_PMIC_SPI_MISO__FUNC_PMIC_SPI_MISO>;
		};
	};

	i2c1_pins: i2c1-pins {
		pins {
			pinmux = <MT6572_PIN_113_SCL_1_0__FUNC_SCL_1_0>,
				 <MT6572_PIN_114_SDA_1_0__FUNC_SDA_1_0>;
		};
	};

	kpd_pins: kpd-pins {
		pins {
			pinmux = <MT6572_PIN_107_KCOL0__FUNC_KCOL0>,
				 <MT6572_PIN_108_KCOL1__FUNC_KCOL1>,
				 <MT6572_PIN_109_KCOL2__FUNC_KCOL2>,
				 <MT6572_PIN_110_KROW0__FUNC_KROW0>,
				 <MT6572_PIN_111_KROW1__FUNC_KROW1>,
				 <MT6572_PIN_112_KROW2__FUNC_KROW2>,
				 <MT6572_PIN_142_BPI_BUS12__FUNC_KROW3>,
				 <MT6572_PIN_143_BPI_BUS13__FUNC_KROW4>;
			input-enable;
			bias-pull-up;
		};
	};

	mmc0_pins: mmc0-pins {

		pins-clk {
			pinmux = <MT6572_PIN_44_MC0_CK__FUNC_MC0_CK>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			/* Vendor eMMC setup uses 6 mA for CLK/CMD/DAT. */
			drive-strength = <6>;
		};

		pins-cmd-dat {
			pinmux = <MT6572_PIN_45_MC0_CMD__FUNC_MC0_CMD>,
				 <MT6572_PIN_46_MC0_DAT0__FUNC_MC0_DAT0>;
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			/* Vendor eMMC setup uses 6 mA for CLK/CMD/DAT. */
			drive-strength = <6>;
		};

		/*
		 * Keep eMMC RST_n deasserted. Pin 54 is PULLSEL-type on
		 * MT6572 (not R1R0), so use plain bias-pull-up rather than
		 * Prestigio's R1R0 encoding that would -ENOTSUPP. Stage A
		 * still only talks CMD/DAT0; RST is held high.
		 */
		pins-rst {
			pinmux = <MT6572_PIN_54_MC0_RSTB__FUNC_MC0_RSTB>;
			bias-pull-up;
		};
	};
};

&keyboard {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&kpd_pins>;
	/* Z1 keypad matrix fixed at 8 rows x 9 cols (72-slot table) */
	keypad,num-rows = <8>;
	keypad,num-columns = <9>;
	debounce-delay-ms = <32>;
	linux,keymap = <
		MATRIX_KEY(0, 0, KEY_VOLUMEDOWN)	/* idx0: 114 */
		MATRIX_KEY(0, 1, 251)		/* idx1: 251 */
		MATRIX_KEY(0, 2, 250)		/* idx2: 250 */
		MATRIX_KEY(1, 0, KEY_VOLUMEUP)		/* idx9: 115 */
		MATRIX_KEY(1, 1, 252)		/* idx10: 252 */
		MATRIX_KEY(2, 0, 106)		/* idx18: 106 */
		MATRIX_KEY(2, 1, 232)		/* idx19: 232 */
		MATRIX_KEY(2, 2, 105)		/* idx20: 105 */
		MATRIX_KEY(3, 1, KEY_UP)		/* idx28: 103 */
		MATRIX_KEY(4, 0, KEY_BACK)		/* idx36: 158 */
		MATRIX_KEY(4, 1, KEY_DOWN)		/* idx37: 108 */
		MATRIX_KEY(4, 2, 254)		/* idx38: 254 */
	>;
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;

	/*
	 * Touch identity evidence (updated 2026-08-29, see
	 * mainline_recon/TOUCH_CST836U_20260829.md):
	 * - Factory kernel carries a Hynitron CST836U driver ("HYN_CST836U_
	 *   DWZN_MT6572_4.4_V1.0_20181106" inside 1/boot.img) and the vendor
	 *   runtime probed hyn_ts at I2C1 0x15 (probe FAILED, physical
	 *   presence unproven).
	 * - EdgeTX upstream (radio/src/targets/pl18/touch_driver.cpp) drives a
	 *   CST836U at 0x15 with an FT6206-style 8-bit-register protocol:
	 *   0x02 touch count, 0x03..06 XH/XL/YH/YL (12-bit, event bits 7:6,
	 *   contact=2), identity at 0xa6-0xab.  => the in-tree edt-ft5x06
	 *   driver with compatible "focaltech,ft6236" is the match; the two
	 *   hynitron-* drivers in-tree are NOT (CST3XX 16-bit / CST816S 0x01
	 *   protocols).  CONFIG_TOUCHSCREEN_EDT_FT5X06=m is already set.
	 * - Reset/IRQ GPIOs remain UNPROVEN for Z1 (128/129 are reference-
	 *   board values), so no client node is enabled yet: v13.4 ships
	 *   sbin/i2cprobe; run on-board (serial shell):
	 *     i2cprobe /dev/i2c-1 0x15
	 *     i2cprobe /dev/i2c-1 dump 0x15 0xa6 6   # FW/module/project/chip-id
	 * Enable the ft6236 node only after that evidence and proven GPIOs.
	 * GT911 stays disabled (audit: factory-image evidence outranks the
	 * cci72_we_jb3 reference-board guess).
	 */
	touchscreen@5d {
		status = "disabled";
		compatible = "goodix,gt911";
		reg = <0x5d>;

		interrupt-parent = <&pio>;
		interrupts = <1 IRQ_TYPE_EDGE_RISING>;
		irq-gpios = <&pio 129 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 128 GPIO_ACTIVE_HIGH>;

		AVDD28-supply = <&mt6323_vgp1_reg>;
		VDDIO-supply = <&mt6323_vio18_reg>;

		/* TBC on-board: Z1 actual touch panel resolution */
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		touchscreen-inverted-x;

		/* 3 Android capacitive keys: Back/Home/MultiTask (no Search) */
		goodix,keymap = <KEY_BACK KEY_HOME KEY_APPSELECT 0 0 0 0>;
	};
};

/*
 * Z1 display panel (Sitronix ST7785M 240x320 DSI) -- DT preparation only.
 *
 * The ST7785M is the Z1 screen. This child node is a placeholder; it stays
 * disabled because the whole DSI path is not ready on mainline yet:
 *   - &dsi (mediatek,mt6572-dsi) is still status="disabled" in mt6572.dtsi
 *   - requires CONFIG_DRM_MEDIATEK (mtk_drm + mtk_dsi) plus a working
 *     mt6572-m4u IOMMU and the DIS power domain
 *   - during current bring-up the LK-composed framebuffer is driven via the
 *     simple-framebuffer in chosen/framebuffer0 above, not DRM
 *
 * To enable on-board later: set &dsi { status = "okay"; }, remove
 * status="disabled" here, and wire up panel power/backlight (ST7785M usually
 * needs a reset GPIO + AVDD rail).
 */
&dsi {
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "sitronix,st7785m";
		reg = <0>;
		status = "disabled";
	};
};

/*
 * Z1 backlight: the display backlight is driven by the MT6323 ISINK
 * current sinks (leds-mt6323). The LCD panel's LED string hangs off
 * ISINK0; brightness control is the LED sysfs class
 * (/sys/class/leds/<name>/brightness), matching the vendor 4.4
 * /sys/class/leds/lcd-backlight path.
 */
&mt6323_leds {
	status = "okay";
	/* ISINK0 is the LCD backlight channel on the Z1 board. */
	isink0 {
		reg = <0>;
		label = "lcd-backlight";
		linux,default-trigger = "backlight";
		default-state = "on";
	};
};
